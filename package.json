{
  "name": "filewing",
  "version": "1.0.0",
  "description": "FileWing - 脱PPAP対応のセキュアファイル共有システム",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production",
    "db:migrate": "wrangler d1 migrations apply filewing-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply filewing-db --env production",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.3.0",
    "mimetext": "^3.0.28"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240419.0",
    "typescript": "^5.4.5",
    "wrangler": "^3.53.0"
  }
}
